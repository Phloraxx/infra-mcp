# MCP gateway
PORT=3000
BIND_HOST=127.0.0.1
AGENT_SOCKET=/run/infra-mcp/agent.sock

# Generate a long random value and configure the same value for both services.
# Example: openssl rand -hex 32
AGENT_TOKEN=replace-with-a-long-random-secret

# Host agent
AGENT_SOCKET_MODE=0660
# Optional numeric group ID that should own the Unix socket.
# Set this to the GID added to the mcp-server container.
AGENT_SOCKET_GID=

# Docker Compose / Dokploy
INFRA_MCP_GID=999

# IMPORTANT:
# The initial MCP gateway does not implement public OAuth yet.
# Keep it private or use OpenAI Secure MCP Tunnel until OAuth is configured.

# ------------------------------------------------------------------
# Rust Infra v1 gateway (crates/gateway)
# ------------------------------------------------------------------
# Address the gateway binds to. Default: 127.0.0.1:8788
# A non-loopback bind refuses to start without INFRA_ADMIN_TOKEN.
INFRA_GATEWAY_BIND=127.0.0.1:8788

# Admin bearer token for gateway and dashboard APIs.
# Required (>= 32 bytes) for any non-loopback bind.
# Generate with: openssl rand -hex 32
INFRA_ADMIN_TOKEN=replace-with-a-long-random-secret

# SQLite database location. Default: ./data/infra-v1.db
INFRA_DB_PATH=./data/infra-v1.db

# Optional: owner auth file enabling browser dashboard sessions.
# INFRA_DASHBOARD_AUTH_FILE=/path/to/dashboard-auth.json

# Optional: legacy v0.3 agent token bridge (INFRA_AGENT_TOKEN is also honored).
# INFRA_LEGACY_AGENT_TOKEN=replace-with-a-long-random-secret

# Optional Hermes bridge: enable and point at the Hermes service.
# INFRA_HERMES_ENABLED=1
# INFRA_HERMES_BASE_URL=http://127.0.0.1:8000
# INFRA_HERMES_RUNS_ENABLED=1
# INFRA_HERMES_MEMORY_WRITES=1
